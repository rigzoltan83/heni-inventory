FLASK_APP=run.py
FLASK_ENV=production

# Generate a strong random value for production.
SECRET_KEY=change-me

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://username_inventory_user:change-me@127.0.0.1:5432/username_inventory

# Development server settings.
APP_HOST=127.0.0.1
APP_PORT=5070

# Optional reverse-proxy URL prefix.
# Example:
# APP_PREFIX=/inventory
APP_PREFIX=

# Optional item image directory.
# If omitted, uploads/items inside the project directory is used.
# ITEM_UPLOAD_FOLDER=/opt/username-inventory/uploads/items
